{
  "name": "dsh-watchlist",
  "version": "1.0.0",
  "type": "module",
  "description": "在侧边栏对话列表上方增加关注区：状态圆点、新回复置顶、运行中的置底，模型选择器旁还有关注按钮。 Follow list above the sidebar conversation list, with a follow toggle beside the model selector.",
  "license": "MIT",
  "author": "774015352-sys",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/774015352-sys/dsh-watchlist.git"
  },
  "homepage": "https://github.com/774015352-sys/dsh-watchlist#readme",
  "bugs": {
    "url": "https://github.com/774015352-sys/dsh-watchlist/issues"
  },
  "icon": "icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "watchlist",
    "sidebar",
    "unread",
    "follow"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
